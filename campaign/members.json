{
  "schemaVersion": "tl-mltl.campaign-members/v1",
  "tools": [
    {"name": "rustc", "command": ["rustc", "--version"]},
    {"name": "cargo", "command": ["cargo", "--version"]},
    {"name": "rustfmt", "command": ["rustfmt", "--version"]},
    {"name": "clippy", "command": ["cargo", "clippy", "--version"]},
    {"name": "cargo-fuzz", "command": ["cargo", "fuzz", "--version"]},
    {"name": "cargo-kani", "command": ["cargo", "kani", "--version"]},
    {"name": "cargo-mutants", "command": ["cargo", "mutants", "--version"]},
    {"name": "cargo-llvm-cov", "command": ["cargo", "llvm-cov", "--version"]},
    {"name": "quire", "command": ["quire", "--version"]},
    {"name": "r2u2", "command": ["cargo", "run", "--quiet", "--bin", "r2u2_live", "--", "probe"]}
  ],
  "members": [
    {
      "id": "format",
      "technique": "static",
      "kind": "test",
      "command": ["cargo", "fmt", "--all", "--", "--check"],
      "tools": ["rustfmt"],
      "determinism": "exact",
      "covers": ["make:fmt-check"]
    },
    {
      "id": "lint",
      "technique": "static",
      "kind": "test",
      "command": ["cargo", "clippy", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "tools": ["clippy"],
      "determinism": "exact",
      "covers": ["make:lint"]
    },
    {
      "id": "test-suite",
      "technique": "tests",
      "kind": "test",
      "command": ["cargo", "test", "--all-targets", "--all-features"],
      "tools": ["cargo"],
      "determinism": "exact",
      "covers": ["make:test"]
    },
    {
      "id": "reference-conformance",
      "technique": "conformance",
      "kind": "test",
      "command": ["make", "conformance"],
      "tools": ["cargo"],
      "determinism": "exact",
      "covers": ["make:conformance"]
    },
    {
      "id": "cli-conformance",
      "technique": "conformance",
      "kind": "test",
      "command": ["make", "cli-conformance"],
      "tools": ["cargo"],
      "determinism": "exact",
      "covers": ["make:cli-conformance"]
    },
    {
      "id": "r2u2-retained-replay",
      "technique": "differential",
      "kind": "differential",
      "command": ["make", "differential"],
      "tools": ["cargo"],
      "determinism": "exact",
      "covers": ["make:differential"],
      "note": "Replays retained bytes under corpus/r2u2-v4.2; it does not execute R2U2."
    },
    {
      "id": "r2u2-past-live",
      "technique": "differential",
      "kind": "differential",
      "command": ["make", "r2u2-past-differential"],
      "tools": ["r2u2"],
      "determinism": "exact",
      "covers": ["make:r2u2-past-differential"],
      "note": "Live pinned R2U2 over the past grid; unavailable unless R2U2_ROOT is a pinned build."
    },
    {
      "id": "r2u2-past-recorded",
      "technique": "differential",
      "kind": "differential",
      "command": ["make", "r2u2-past-replay"],
      "tools": ["r2u2"],
      "determinism": "exact",
      "covers": ["make:r2u2-past-replay"],
      "note": "Recomputes the comparison from the outputs r2u2-past-live recorded; runs after it."
    },
    {
      "id": "sweep-small-scope-fast",
      "technique": "exhaustive-sweep",
      "kind": "sweep",
      "command": ["cargo", "test", "--test", "finite_oracle"],
      "tools": ["cargo"],
      "determinism": "exact",
      "evidence": {"env": "TL_MLTL_EVIDENCE_DIR", "volatileKeys": ["runtimeMs"]},
      "covers": []
    },
    {
      "id": "sweep-small-scope-full",
      "technique": "exhaustive-sweep",
      "kind": "sweep",
      "command": ["make", "sweep-full"],
      "tools": ["cargo"],
      "determinism": "exact",
      "evidence": {"env": "TL_MLTL_EVIDENCE_DIR", "volatileKeys": ["runtimeMs"]},
      "covers": ["make:sweep-full"],
      "note": "Nightly-scale; release build, long."
    },
    {
      "id": "fuzz-c2po-map-corpus",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "test", "--test", "c2po_map_fuzz"],
      "tools": ["cargo"],
      "determinism": "exact",
      "covers": []
    },
    {
      "id": "fuzz-c2po-map-live",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "fuzz", "run", "c2po_map", "--", "-runs=100000", "-seed=5457"],
      "tools": ["cargo-fuzz"],
      "determinism": "seeded",
      "seed": "5457",
      "covers": ["fuzz:c2po_map"]
    },
    {
      "id": "fuzz-evaluator-differential-live",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "fuzz", "run", "evaluator_differential", "fuzz/corpus/evaluator_differential", "--", "-runs=20000", "-seed=230", "-rss_limit_mb=8192"],
      "tools": ["cargo-fuzz"],
      "determinism": "seeded",
      "seed": "230",
      "covers": ["fuzz:evaluator_differential"]
    },
    {
      "id": "fuzz-wire-cli-decode-live",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "fuzz", "run", "wire_cli_decode", "fuzz/corpus/wire_cli_decode", "--", "-runs=20000", "-seed=229", "-rss_limit_mb=8192"],
      "tools": ["cargo-fuzz"],
      "determinism": "seeded",
      "seed": "229",
      "covers": ["fuzz:wire_cli_decode"]
    },
    {
      "id": "fuzz-history-intake-live",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "fuzz", "run", "history_intake", "fuzz/corpus/history_intake", "--", "-runs=20000", "-seed=231", "-rss_limit_mb=8192"],
      "tools": ["cargo-fuzz"],
      "determinism": "seeded",
      "seed": "231",
      "covers": ["fuzz:history_intake"]
    },
    {
      "id": "fuzz-build-and-audit",
      "technique": "static",
      "kind": "test",
      "command": ["make", "fuzz-check"],
      "tools": ["cargo-fuzz"],
      "determinism": "exact",
      "covers": ["make:fuzz-check"]
    },
    {
      "id": "fuzz-corpus-replay",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["make", "fuzz-smoke"],
      "tools": ["cargo-fuzz"],
      "determinism": "exact",
      "covers": ["make:fuzz-smoke"]
    },
    {
      "id": "fuzz-infinite-seeds",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "test", "--features", "infinite-trace", "--test", "infinite_fuzz_seeds"],
      "tools": ["cargo"],
      "determinism": "exact",
      "covers": []
    },
    {
      "id": "fuzz-lasso-differential-live",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "fuzz", "run", "lasso_differential", "--", "-runs=20000", "-seed=20261108"],
      "tools": ["cargo-fuzz"],
      "determinism": "seeded",
      "seed": "20261108",
      "covers": ["fuzz:lasso_differential"]
    },
    {
      "id": "fuzz-partial-valuation-monotone-live",
      "technique": "fuzz",
      "kind": "fuzz",
      "command": ["cargo", "fuzz", "run", "partial_valuation_monotone", "--", "-runs=20000", "-seed=20261108"],
      "tools": ["cargo-fuzz"],
      "determinism": "seeded",
      "seed": "20261108",
      "covers": ["fuzz:partial_valuation_monotone"]
    },
    {
      "id": "kani-horizon-bound",
      "technique": "kani",
      "kind": "kani",
      "command": ["make", "kani-check"],
      "tools": ["cargo-kani"],
      "determinism": "exact",
      "covers": ["make:kani-check"]
    },
    {
      "id": "mutation",
      "technique": "mutation",
      "kind": "mutation",
      "command": ["make", "mutants"],
      "tools": ["cargo-mutants"],
      "determinism": "exact",
      "covers": ["make:mutants"],
      "note": "Full run, hours (TL-231). The mutant population is fixed by --no-shuffle; kill-rate thresholds are in mutation-thresholds.toml."
    },
    {
      "id": "mutation-diff",
      "technique": "mutation",
      "kind": "mutation",
      "command": ["make", "mutants-diff"],
      "tools": ["cargo-mutants"],
      "determinism": "exact",
      "covers": ["make:mutants-diff"],
      "note": "Mutants in the diff against origin/main must all be killed (TL-231)."
    },
    {
      "id": "coverage",
      "technique": "coverage",
      "kind": "coverage",
      "command": ["make", "coverage"],
      "tools": ["cargo-llvm-cov"],
      "determinism": "exact",
      "covers": ["make:coverage"],
      "note": "Line, function and region coverage on the pinned toolchain (TL-234)."
    },
    {
      "id": "coverage-branch",
      "technique": "coverage",
      "kind": "coverage",
      "command": ["make", "coverage-branch"],
      "tools": ["cargo-llvm-cov"],
      "determinism": "exact",
      "covers": ["make:coverage-branch"],
      "note": "Adds branch coverage; requires a nightly toolchain with llvm-tools (TL-234)."
    },
    {
      "id": "r2u2-nightly",
      "technique": "differential",
      "kind": "differential",
      "command": ["make", "r2u2-nightly"],
      "tools": ["r2u2"],
      "determinism": "exact",
      "covers": ["make:r2u2-nightly"],
      "note": "Past grid plus exhaustive future suite against the pinned R2U2; unavailable unless R2U2_ROOT is a pinned build."
    }
  ]
}
