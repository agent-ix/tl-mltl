      "value": "clean"
    }
  ],
  "inputs": [],
  "outputs": [],
  "producerName": "cargo-mutants",
  "producerVersion": "27.0.0",
  "repetitions": 1,
  "responseAdapter": "quoin.process-evidence-adapter",
  "responseAdapterVersion": "1",
