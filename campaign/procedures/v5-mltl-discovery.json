{
  "arguments": [
    {
      "kind": "literal",
      "value": "mutants"
    },
    {
      "kind": "literal",
      "value": "--no-config"
    },
    {
      "kind": "literal",
      "value": "--all-features"
    },
    {
      "kind": "literal",
      "value": "--list"
    },
    {
      "kind": "literal",
      "value": "--json"
    },
    {
      "kind": "literal",
      "value": "--file"
    },
    {
      "kind": "literal",
      "value": "src/infinite/mod.rs"
    }
  ],
  "environment": [
    {
      "kind": "runtime",
      "name": "PATH",
      "value": "host:PATH"
    },
    {
      "kind": "runtime",
      "name": "HOME",
      "value": "host:HOME"
    },
    {
      "kind": "runtime",
      "name": "CARGO_HOME",
      "value": "host:CARGO_HOME"
    },
    {
      "kind": "runtime",
      "name": "RUSTUP_HOME",
      "value": "host:RUSTUP_HOME"
    },
    {
      "kind": "runtime",
      "name": "CARGO_TARGET_DIR",
      "value": "host:CARGO_TARGET_DIR"
    },
    {
      "kind": "runtime",
      "name": "TMPDIR",
      "value": "host:TMPDIR"
    },
    {
      "kind": "runtime",
      "name": "RUSTC",
      "value": "host:RUSTC"
    },
    {
      "kind": "literal",
      "name": "CARGO_NET_OFFLINE",
      "value": "true"
