+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{BufRead, BufReader, Read};
+    use std::process::Stdio;
+
+    #[test]
+    fn default_mode_keeps_private_process_group() {
+        let mut command = Command::new("sleep");
+        command.arg("30");
+        configure_command_with_mode(&mut command, false);
+        let mut child = command.spawn().unwrap();
+        let child_pid = Pid::from_raw(child.id().try_into().unwrap());
+        assert_eq!(nix::unistd::getpgid(Some(child_pid)).unwrap(), child_pid);
+        assert_ne!(child_pid, nix::unistd::getpgrp());
+        terminate_child_with_mode(&mut child, false).unwrap();
+        assert!(!child.wait().unwrap().success());
+    }
+
+    #[test]
+    fn quoin_opt_in_inherits_group_and_bounds_sigterm_resistant_child() {
+        let mut command = Command::new("sh");
+        command
+            .args(["-c", "trap '' TERM; printf ready; exec sleep 30"])
+            .stdout(Stdio::piped());
+        configure_command_with_mode(&mut command, true);
+        let mut child = command.spawn().unwrap();
+        let mut ready = [0; 5];
+        child.stdout.take().unwrap().read_exact(&mut ready).unwrap();
+        assert_eq!(&ready, b"ready");
+        let child_pid = Pid::from_raw(child.id().try_into().unwrap());
+        assert_eq!(
+            nix::unistd::getpgid(Some(child_pid)).unwrap(),
+            nix::unistd::getpgrp()
+        );
+        let start = Instant::now();
+        terminate_child_with_mode(&mut child, true).unwrap();
+        assert!(start.elapsed() < Duration::from_secs(2));
+        assert!(!child.wait().unwrap().success());
+    }
+
+    #[test]
+    fn quoin_opt_in_leaves_descendant_for_outer_group_cleanup() {
+        // This is the cooperative boundary: Quoin must terminate the group
+        // when cargo-mutants exits. The inner timeout signals only its child.
+        let mut command = Command::new("sh");
+        command
+            .args(["-c", "sleep 30 & printf '%s\\n' \"$!\"; exec sleep 30"])
+            .stdout(Stdio::piped());
+        configure_command_with_mode(&mut command, true);
+        let mut child = command.spawn().unwrap();
+        let mut line = String::new();
+        BufReader::new(child.stdout.take().unwrap())
+            .read_line(&mut line)
+            .unwrap();
+        let descendant = Pid::from_raw(line.trim().parse().unwrap());
+        terminate_child_with_mode(&mut child, true).unwrap();
+        child.wait().unwrap();
+        assert!(kill(descendant, None).is_ok());
+        kill(descendant, Signal::SIGKILL).unwrap();
+    }
+}
