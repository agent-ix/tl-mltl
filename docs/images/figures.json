        {"k": "box", "at": [805, 130, 165, 56], "role": "ink", "title": "R2U2 {tool}", "subs": ["out of band"]},
        {"k": "box", "at": [805, 236, 165, 62], "role": "evidence", "title": "agreement", "subs": ["{agreements} of {supported} supported"]},
        {"k": "line", "points": [[735, 55], [802, 55]], "role": "evidence"},
        {"k": "note", "at": [741, 49], "text": "verdict", "role": "evidence"},
        {"k": "line", "points": [[735, 267], [770, 267], [770, 158], [802, 158]], "role": "model"},
        {"k": "line", "points": [[887, 127], [887, 89]], "role": "ink"},
        {"k": "line", "points": [[970, 55], [976, 55], [976, 267], [973, 267]], "role": "evidence"},
        {"k": "legend", "at": [0, 340], "entries": [["code", "authored source", "box"], ["logic", "processing step", "box"], ["model", "checked document / view", "box"], ["evidence", "outcome", "box"], ["ink", "input", "box"]]}
      ]
