{
  "style": "ix-docs",
  "data": {
    "trace": {"from": "json", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/trace"},
    "ninst": {"from": "json", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/trace", "length": true},
    "minus_one": {"from": "text", "value": "-1"},
    "lastinst": {"from": "sum", "of": ["ninst", "minus_one"]},
    "tool": {"from": "regex", "path": "corpus/r2u2-v4.2/manifest.json", "pattern": "\"tag\": \"([^\"-]*)"},
    "instants": {"from": "instants", "of": "trace"},
    "agreements": {"from": "json", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/agreements"},
    "supported": {"from": "json", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/supported"},

    "hero_nodes": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-until-lower-bound-v1", "field": "/formula/nodes"},
    "hn0": {"from": "node", "of": "hero_nodes", "index": 0},
    "hn1": {"from": "node", "of": "hero_nodes", "index": 1},
    "hn2": {"from": "node", "of": "hero_nodes", "index": 2},
    "hero_profile": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-until-lower-bound-v1", "field": "/formula/semantic_profile"},
    "hero_index": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-until-lower-bound-v1", "field": "/formulaIndex"},
    "hero_spec": {"from": "nth", "path": "corpus/r2u2-v4.2/formulas.c2po", "pattern": "(?m)^ {4}(.*?);[ \\t]*$", "exclude": "bool", "index_of": "hero_index"},
    "hero_verdict": {"from": "find", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/cases", "key": "id", "equals": "r2u2-until-lower-bound-v1", "field": "/verdict"},
    "hero_time": {"from": "find", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/cases", "key": "id", "equals": "r2u2-until-lower-bound-v1", "field": "/verdictTime"},
    "look": {"from": "json", "path": "corpus/r2u2-v4.2/records/r2u2-until-lower-bound-v1.json", "pointer": "/horizon", "raw": true},
    "buffer": {"from": "expr", "value": "look + 1"},

    "scn_prop": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/formula/nodes/0/proposition"},
    "scn_kind": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/formula/nodes/1/kind"},
    "scn_operand": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/formula/nodes/1/operand"},
    "scn_start": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/formula/nodes/1/interval/start"},
    "scn_end": {"from": "find", "path": "corpus/r2u2-v4.2/manifest.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/formula/nodes/1/interval/end"},
    "scn_verdict": {"from": "find", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/verdict"},
    "scn_time": {"from": "find", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/verdictTime"},
    "scn_shape": {"from": "expect", "of": "scn_kind", "equals": "future"},
    "scn_operand_ok": {"from": "expect", "of": "scn_operand", "equals": "0"},
    "scn_prop_ok": {"from": "expect", "of": "scn_prop", "equals": "2"},
    "scn_start_ok": {"from": "expect", "of": "scn_start", "equals": "0"},
    "scn_end_ok": {"from": "expect", "of": "scn_end", "equals": "3"},
    "scn_false": {"from": "expect", "of": "scn_verdict", "equals": "false"},
    "scn_held": {"from": "held", "of": "trace", "prop": 2, "first": 0, "last": 3},
    "scn_never": {"from": "expect", "of": "scn_held", "equals": "0"},
    "scn_look": {"from": "json", "path": "corpus/r2u2-v4.2/records/r2u2-future-deadline-v1.json", "pointer": "/horizon", "raw": true},
    "scn_buffer": {"from": "expr", "value": "scn_look + 1"},
    "scn_buffer_ok": {"from": "expect", "of": "scn_buffer", "equals": "4"},
    "scn_time_ok": {"from": "expect", "of": "scn_time", "equals": "0"},
    "scn_status": {"from": "find", "path": "corpus/r2u2-v4.2/differential-report.json", "pointer": "/cases", "key": "id", "equals": "r2u2-future-deadline-v1", "field": "/status"},
    "scn_agree": {"from": "expect", "of": "scn_status", "equals": "agreement"},
    "scn_csv": {"from": "trace-csv", "of": "trace", "path": "corpus/r2u2-v4.2/trace.csv", "props": [0, 1, 2]},
    "c00": {"from": "cell", "of": "trace", "instant": 0, "prop": 0, "hit": "true", "miss": "false"},
    "c01": {"from": "cell", "of": "trace", "instant": 1, "prop": 0, "hit": "true", "miss": "false"},
    "c02": {"from": "cell", "of": "trace", "instant": 2, "prop": 0, "hit": "true", "miss": "false"},
    "c03": {"from": "cell", "of": "trace", "instant": 3, "prop": 0, "hit": "true", "miss": "false"},
    "c10": {"from": "cell", "of": "trace", "instant": 0, "prop": 1, "hit": "true", "miss": "false"},
    "c11": {"from": "cell", "of": "trace", "instant": 1, "prop": 1, "hit": "true", "miss": "false"},
    "c12": {"from": "cell", "of": "trace", "instant": 2, "prop": 1, "hit": "true", "miss": "false"},
    "c13": {"from": "cell", "of": "trace", "instant": 3, "prop": 1, "hit": "true", "miss": "false"},
    "c20": {"from": "cell", "of": "trace", "instant": 0, "prop": 2, "hit": "true", "miss": "false"},
    "c21": {"from": "cell", "of": "trace", "instant": 1, "prop": 2, "hit": "true", "miss": "false"},
    "c22": {"from": "cell", "of": "trace", "instant": 2, "prop": 2, "hit": "true", "miss": "false"},
    "c23": {"from": "cell", "of": "trace", "instant": 3, "prop": 2, "hit": "true", "miss": "false"},
    "n00": {"from": "cell", "of": "trace", "instant": 0, "prop": 0, "hit": "false", "miss": "true"},
    "n01": {"from": "cell", "of": "trace", "instant": 1, "prop": 0, "hit": "false", "miss": "true"},
    "n02": {"from": "cell", "of": "trace", "instant": 2, "prop": 0, "hit": "false", "miss": "true"},
    "n03": {"from": "cell", "of": "trace", "instant": 3, "prop": 0, "hit": "false", "miss": "true"},
    "n10": {"from": "cell", "of": "trace", "instant": 0, "prop": 1, "hit": "false", "miss": "true"},
    "n11": {"from": "cell", "of": "trace", "instant": 1, "prop": 1, "hit": "false", "miss": "true"},
    "n12": {"from": "cell", "of": "trace", "instant": 2, "prop": 1, "hit": "false", "miss": "true"},
    "n13": {"from": "cell", "of": "trace", "instant": 3, "prop": 1, "hit": "false", "miss": "true"},
    "n20": {"from": "cell", "of": "trace", "instant": 0, "prop": 2, "hit": "false", "miss": "true"},
    "n21": {"from": "cell", "of": "trace", "instant": 1, "prop": 2, "hit": "false", "miss": "true"},
    "n22": {"from": "cell", "of": "trace", "instant": 2, "prop": 2, "hit": "false", "miss": "true"},
    "n23": {"from": "cell", "of": "trace", "instant": 3, "prop": 2, "hit": "false", "miss": "true"}
  },
  "figures": [
    {
      "id": "hero", "width": 980, "height": 356,
      "label": "A formula and a trace go into tl-mltl. evaluate_closed or evaluate_prefix returns a verdict, here {hero_verdict} at time {hero_time}, and pending when the prefix does not decide it. analyze_horizon returns a lookahead of {look} and a buffer of {buffer} instants. map_to_c2po returns a manifest with the C2PO expression and SHA-256 digests of its input and output. C2PO and R2U2 run outside this crate, and compare_external classifies their verdict against the reference verdict, here {agreements} of {supported} supported cases agree.",
      "items": [
        {"k": "box", "at": [0, 24, 240, 62], "role": "ink", "title": "trace", "subs": ["{instants}", "propositions per instant"]},
        {"k": "box", "at": [0, 122, 240, 118], "role": "code", "title": "formula", "subs": ["{hn0}", "{hn1}", "{hn2}", "{hero_profile}"]},
        {"k": "line", "points": [[240, 55], [302, 55]], "role": "ink"},
        {"k": "note", "at": [246, 49], "text": "trace", "role": "ink"},
        {"k": "line", "points": [[240, 181], [272, 181]], "role": "code", "arrow": false},
        {"k": "line", "points": [[272, 70], [272, 267]], "role": "code", "arrow": false},
        {"k": "line", "points": [[272, 70], [302, 70]], "role": "code"},
        {"k": "line", "points": [[272, 158], [302, 158]], "role": "code"},
        {"k": "line", "points": [[272, 267], [302, 267]], "role": "code"},
        {"k": "box", "at": [305, 24, 180, 62], "role": "logic", "title": "evaluate_prefix", "subs": ["or evaluate_closed"]},
        {"k": "box", "at": [305, 130, 180, 56], "role": "logic", "title": "analyze_horizon", "subs": ["checked sums"]},
        {"k": "box", "at": [305, 236, 180, 62], "role": "logic", "title": "map_to_c2po", "subs": ["online-prefix only"]},
        {"k": "box", "at": [555, 24, 180, 62], "role": "evidence", "title": "verdict", "subs": ["{hero_verdict} at time {hero_time}", "or pending"]},
        {"k": "box", "at": [555, 130, 180, 56], "role": "evidence", "title": "HorizonReport", "subs": ["lookahead {look} · buffer {buffer}"]},
        {"k": "box", "at": [555, 236, 180, 62], "role": "model", "title": "MappingManifest", "subs": ["C2PO  {hero_spec}", "SHA-256 digests"]},
        {"k": "line", "points": [[485, 55], [552, 55]], "role": "logic", "weight": 2.4},
        {"k": "line", "points": [[485, 158], [552, 158]], "role": "logic", "weight": 2.4},
